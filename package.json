{
  "name": "vwapp-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @vwapp/backend run dev",
    "ios": "pnpm --filter @vwapp/mobile run ios",
    "version": "node scripts/version.mts",
    "publish:ios": "pnpm --filter @vwapp/mobile run publish:ios",
    "deploy": "pnpm --filter @vwapp/backend run deploy",
    "test": "tsc --noEmit -p scripts/tsconfig.json && eslint scripts && pnpm --recursive --parallel --aggregate-output run \"/^(typecheck|lint|format:check)$/\"",
    "test:vw": "node --import ./backend/tests/register.mjs --test backend/tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && pnpm --recursive --parallel run typecheck",
    "lint": "eslint scripts && pnpm --recursive --parallel run lint",
    "format": "pnpm --recursive --parallel --aggregate-output run format",
    "backend:node": "pnpm --filter @vwapp/backend run node:start",
    "backend:node:build": "pnpm --filter @vwapp/backend run node:build",
    "backend:node:test": "pnpm --filter @vwapp/backend run node:test",
    "backend:storage:test": "pnpm --filter @vwapp/backend run storage:test",
    "backend:auth:test": "pnpm --filter @vwapp/backend run auth:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  },
  "private": true
}
