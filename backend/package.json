{
  "name": "@vwapp/backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run node:start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p node/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "node:build": "esbuild node/main.ts --bundle --platform=node --format=esm --target=node22 --main-fields=module,main --outfile=../dist/node/main.mjs",
    "node:start": "pnpm run node:build && node ../dist/node/main.mjs",
    "node:test": "node --import ./tests/register.mjs --test node/tests/*.test.mjs",
    "storage:test": "node --import ./tests/register.mjs --test storage/tests/*.test.mjs",
    "auth:test": "node --import ./tests/register.mjs --test auth/tests/*.test.mjs",
    "auth:admin:build": "esbuild auth/admin.ts --bundle --platform=node --format=esm --target=node22 --outfile=../dist/node/auth-admin.mjs",
    "container:smoke:build": "esbuild node/tests/container-smoke.ts --bundle --platform=node --format=esm --target=node22 --outfile=../dist/node/container-smoke.mjs"
  },
  "dependencies": {
    "@vwapp/contract": "workspace:*",
    "nostr-tools": "2.25.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "esbuild": "0.28.1"
  },
  "private": true
}
